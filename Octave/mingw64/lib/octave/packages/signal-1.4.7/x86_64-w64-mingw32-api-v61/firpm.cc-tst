%! title (sprintf ('firpm type-I brick-wall low-pass filter (order=%i)', length (b) - 1));
%! ylabel ('Magnitude response (dB)'); xlabel ('Frequency (normalized)')
%! grid on; axis ([0 1 -100 5]); set (gca, 'xtick', [0:.1:1])
