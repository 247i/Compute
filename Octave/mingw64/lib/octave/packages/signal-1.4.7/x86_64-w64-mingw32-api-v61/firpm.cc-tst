%!demo
%!
%! curve = @(a,b,y,z,x) z*(b-a)./((x-a)*z/y+b-x);
%! respFn = @(n,f,g,w,curve) deal (g>=f(3) & g<=f(4), ...
%!   (g<=f(2)).*curve (f(2),f(1),w(1),w(3),g) + ...
%!   (g>=f(3) & g<=f(4))*w(2) + ...
