CONFIG_VERSION=3.12.1
CONFIG_INST_PREFIX=/usr
CONFIG_INST_LIBS=-L/usr/lib -lgdal
CONFIG_INST_CFLAGS=-I/usr/include
CONFIG_INST_DATA=/usr/share/gdal
prefix=${CONFIG_INST_PREFIX}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include
datadir=${CONFIG_INST_DATA}

Name: libgdal
Description: Geospatial Data Abstraction Library
Version: ${CONFIG_VERSION}
Libs: ${CONFIG_INST_LIBS}
Libs.private: -liconv -lcharset -llzma -lqhull_r -lgeotiff -ltiff -lws2_32 -ljpeg -lpng -lgif -lgta -lpcre2-8 -lsqlite3 -lpq -lexpat -lm -lxml2 -lcurl -lpsapi -lproj -lz -lstdc++ -lgcc_s
Cflags: ${CONFIG_INST_CFLAGS}
