prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}//usr/lib
includedir=${prefix}//usr/include

Name: hdf5
Description: HDF5 (Hierarchical Data Format 5) Software Library
Version: 1.14.3

Cflags: -I${includedir}
Libs: -L${libdir}  -lhdf5
Requires: 
Libs.private:   -lshlwapi -lm -lws2_32 -lwsock32 -l/usr/lib/libz.dll.a
Requires.private: 
