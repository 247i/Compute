prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: 
Requires.private: libgcrypt,zlib
Libs: -L${libdir} -lssh2 
Libs.private:  -lws2_32 -L/usr/lib -lgcrypt -L/usr/lib -lgpg-error -L/usr/lib -lws2_32 -L/usr/lib -lz
Cflags: -I${includedir}
