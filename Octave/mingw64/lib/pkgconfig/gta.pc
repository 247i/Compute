prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: gta
Description: Library to read and write Generic Tagged Arrays (GTAs)
URL: https://marlam.de/gta
Version: 1.2.0
Libs: -L${libdir} -lgta
Libs.private:   
Cflags: -I${includedir}
