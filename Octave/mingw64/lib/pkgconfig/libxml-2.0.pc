prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
modules=1

Name: libXML
Version: 2.15.1
Description: libXML library version2.
Requires.private: 
Libs: -L${libdir} -lxml2 
Libs.private:   -L/usr/lib -lz -liconv -lbcrypt -lm 
Cflags: -I${includedir}/libxml2 
Cflags.private: -DLIBXML_STATIC
