prefix=/scratch/build/mxe-octave-w64/usr/x86_64-w64-mingw32/qt6
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 UiTools
Description: Qt UiTools module
Version: 6.7.3
Libs: -L${libdir} -lQt6UiTools
Cflags: -I${includedir}/QtUiTools -I${includedir} -DQT_UITOOLS_LIB
Requires: Qt6Core Qt6Gui Qt6Widgets Qt6OpenGLWidgets
