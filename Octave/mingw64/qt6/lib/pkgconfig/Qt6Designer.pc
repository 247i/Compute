prefix=/scratch/build/mxe-octave-w64/usr/x86_64-w64-mingw32/qt6
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Designer
Description: Qt Designer module
Version: 6.7.3
Libs: -L${libdir} -lQt6Designer
Cflags: -I${includedir}/QtDesigner -I${includedir} -DQT_DESIGNER_LIB
Requires: Qt6Core Qt6Gui Qt6UiPlugin Qt6Widgets Qt6Xml Qt6OpenGLWidgets
