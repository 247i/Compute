prefix=/scratch/build/mxe-octave-w64/usr/x86_64-w64-mingw32/qt6
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 OpenGLWidgets
Description: Qt OpenGLWidgets module
Version: 6.7.3
Libs: -L${libdir} -lQt6OpenGLWidgets
Cflags: -I${includedir}/QtOpenGLWidgets -I${includedir} -DQT_OPENGLWIDGETS_LIB
Requires: Qt6OpenGL Qt6Widgets
