prefix=/scratch/build/mxe-octave-w64/usr/x86_64-w64-mingw32/qt6
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Xml
Description: Qt Xml module
Version: 6.7.3
Libs: -L${libdir} -lQt6Xml
Cflags: -I${includedir}/QtXml -I${includedir} -DQT_XML_LIB
Requires: Qt6Core
