prefix=/scratch/build/mxe-octave-w64/usr/x86_64-w64-mingw32/qt6
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Core5Compat
Description: Qt Core5Compat module
Version: 6.7.3
Libs: -L${libdir} -lQt6Core5Compat
Cflags: -I${includedir}/QtCore5Compat -I${includedir} -DQT_CORE5COMPAT_LIB
Requires: Qt6Core
